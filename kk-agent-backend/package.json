{
  "name": "kk-agent-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Modular TypeScript API backend with a lightweight plugin system.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "npm --prefix .. --workspace kk-agent-contract run build && tsc",
    "build:desktop": "tsup --config tsup.desktop.config.ts",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx watch index.ts",
    "lint": "npm --prefix .. --workspace kk-agent-contract run build && tsc --noEmit",
    "test": "npm --prefix .. --workspace kk-agent-contract run build && node --import tsx --test \"src/**/*.test.ts\""
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "keywords": [
    "express",
    "plugins",
    "typescript",
    "api"
  ],
  "license": "MIT",
  "dependencies": {
    "kk-agent-contract": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "semver": "^7.6.2",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/semver": "^7.7.1"
  }
}
