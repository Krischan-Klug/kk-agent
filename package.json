{
  "name": "kk-agent-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Modular TypeScript API backend with a lightweight plugin system.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx watch index.ts",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
