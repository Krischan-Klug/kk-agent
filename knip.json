{
  "entry": ["scripts/*.mjs"],
  "project": ["scripts/*.mjs"],
  "workspaces": {
    "kk-agent-backend": {
      "entry": ["index.ts"],
      "project": ["index.ts", "src/**/*.ts", "tsup*.ts"],
      "ignoreDependencies": ["pyodide"]
    },
    "kk-agent-contract": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "kk-agent-desktop": {
      "entry": ["electron/*.ts", "next.config.ts", "src/pages/**/*.{ts,tsx}", "scripts/*.mjs"],
      "project": ["electron/*.ts", "src/**/*.{ts,tsx}", "scripts/*.mjs", "next.config.ts", "eslint.config.mjs", "tsup.config.ts"]
    }
  }
}
